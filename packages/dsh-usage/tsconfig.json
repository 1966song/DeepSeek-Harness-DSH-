      "@deepseek-ai/dsh-client-ui-slots": ["../../deepseek-harness/packages/client/ui-slots/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-client-ui-sidebar": ["../../deepseek-harness/packages/client/ui-sidebar/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-client-ui-sidebar/client": ["../../deepseek-harness/packages/client/ui-sidebar/lib/types/client/index.d.ts"]
