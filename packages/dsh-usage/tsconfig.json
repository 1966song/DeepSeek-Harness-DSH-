      "@deepseek-ai/dsh-llm": ["../../deepseek-harness/packages/llm/llm/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-session-query": ["../../deepseek-harness/packages/session-query/session-query/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-host-webserver": ["../../deepseek-harness/packages/host/webserver/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-credentials": ["../../deepseek-harness/packages/credentials/credentials/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-client-runtime": ["../../deepseek-harness/packages/client/runtime/lib/types/index.d.ts"],
